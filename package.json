{
  "name": "madeonsol-x402",
  "version": "2.2.0",
  "description": "Official TypeScript SDK for the MadeOnSol Solana API — KOL wallet tracking, Pump.fun deployer intelligence, x402 micropayments, and the all-DEX trade firehose. Free tier at madeonsol.com/pricing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node ../gen-version.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs && node --test test/payment-policy.test.mjs test/stream.test.mjs",
    "preflight": "bash ../../scripts/preflight-publish.sh",
    "prepublishOnly": "npm run preflight && npm run build"
  },
  "keywords": [
    "solana",
    "x402",
    "kol",
    "kol-tracker",
    "trading",
    "api",
    "micropayments",
    "ai-agent",
    "memecoin",
    "memecoin-tracker",
    "alpha",
    "alpha-bot",
    "copy-trading",
    "copy-trade",
    "pumpfun",
    "pumpfun-sniper",
    "deployer-hunter",
    "smart-money",
    "trade-stream",
    "solana-trading-bot",
    "madeonsol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/madeonsol/madeonsol-x402"
  },
  "peerDependencies": {
    "@x402/fetch": "^2.11.0",
    "@x402/svm": "^2.11.0",
    "@x402/core": "^2.11.0",
    "@solana/kit": ">=5.5.1 <9.0.0",
    "@scure/base": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@x402/fetch": {
      "optional": true
    },
    "@x402/svm": {
      "optional": true
    },
    "@x402/core": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@scure/base": {
      "optional": true
    }
  }
}
